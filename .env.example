# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Chave secreta (service role), só no servidor. Não use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Endereço público do painel: links dos e-mails, webhook da uazapi e retorno dos agentes.
# Em desenvolvimento use um túnel (cloudflared ou ngrok).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domínio aceito nas contas da equipe (o banco também valida em allowed_email_domains).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=datacrazy.io

# 32 bytes em base64. Criptografa o token da uazapi no banco.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Segredo das rotinas (/api/cron/*). Mesmo valor do segredo crazypanel_cron_secret no Vault.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Cloudflare R2: mídias e PDFs (bucket privado, links temporários)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=crazypanel/

# CRM DataCrazy: documento, responsável e WhatsApp do CRM pelo telefone
DATACRAZY_API_URL=https://api.g1.datacrazy.io/api/v1/crm
DATACRAZY_API_KEY=

# Gleap: leads, empresas e chamados abertos
GLEAP_API_TOKEN=
# Opcional: outro projeto do Gleap (o padrão está em lib/gleap.ts)
GLEAP_PROJECT_ID=

# Formulário de entrada (crazypanel-form): chave compartilhada das rotas /api/verify
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORM_API_KEY=
# Opcional: endereços do formulário aceitos em /api/community/join, separados por vírgula
COMMUNITY_FORM_ORIGINS=

# Código por e-mail: iguais a "Email OTP length" e "Email OTP expiration" do Supabase Auth
EMAIL_OTP_LENGTH=8
EMAIL_OTP_EXPIRY_SECONDS=3600

# Agentes de IA do CRM DataCrazy
# Classificação dos atendimentos
AI_AGENT_WEBHOOK_URL=
# Moderação das mensagens
AI_MODERATION_WEBHOOK_URL=
# Cérebro (base de conhecimento)
AI_BRAIN_WEBHOOK_URL=
# Assina o envio (X-CrazyPanel-Signature) e autentica o retorno e as consultas ao Cérebro (?key=)
AI_WEBHOOK_SECRET=

# Só para o script scripts/legacy-import (importação do sistema antigo)
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_KEY=
