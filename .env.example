# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Chave secreta (service role). Somente servidor: nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL pública do app: links dos e-mails e URL do webhook da uazapi.
# Em dev, a uazapi precisa alcançar o app: use um túnel (cloudflared/ngrok).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domínio permitido para contas (UX; o banco também valida em allowed_email_domains).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=datacrazy.io

# Chave (32 bytes em base64) que criptografa o token da instância uazapi no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Gleap: busca de leads/empresas, base de prospecção e chamados ativos.
GLEAP_API_TOKEN=
# Opcional: outro projeto do Gleap (o padrão está em lib/gleap.ts).
GLEAP_PROJECT_ID=

# CRM DataCrazy (tenant Pós Vendas): CNPJ, responsável e WhatsApp do CRM pelo telefone.
DATACRAZY_API_URL=https://api.g1.datacrazy.io/api/v1/crm
DATACRAZY_API_KEY=

# Vercel Cron (vercel.json): protege /api/cron/* com "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Formulário externo (crazypanel-form): chave compartilhada das rotas /api/verify.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORM_API_KEY=

# Tamanho do código do e-mail (igual ao "Email OTP length" do Supabase Auth)
EMAIL_OTP_LENGTH=8
# Validade do código do e-mail em segundos (igual ao "Email OTP expiration" do Supabase Auth)
EMAIL_OTP_EXPIRY_SECONDS=3600

# Cloudflare R2: mídias e PDFs do painel (bucket privado, links temporários)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=crazypanel/
# Só para configurar o bucket (CORS) pelo script de setup
CLOUDFLARE_API_TOKEN=

# Importação do sistema antigo (groups); só para o script scripts/legacy-import
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_KEY=
